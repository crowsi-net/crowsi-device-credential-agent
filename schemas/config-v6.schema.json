{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://device-credential-agent/config/v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "deployment_role", "endpoint_deployment_id", "configuration_generation",
    "authority_route", "identity_authority_route",
    "pa_authorization_route", "management_projection_trust", "authority_response_key_id",
    "authority_response_public_key_hex", "minimum_identity_config_generation",
    "identity_finalization_authority_id", "revocation_approval_authority_ref",
    "identity_issuer", "identity_audience",
    "identity_key_id", "identity_public_key_hex", "current_status_key_id",
    "current_status_public_key_hex", "user_verification_key_id",
    "user_verification_public_key_hex", "user_verification_credential_id",
    "user_verification_account_binding_sha256",
    "session_sender_key_id",
    "session_sender_key_fingerprint", "session_sender_public_key_hex",
    "session_sender_private_key_path", "session_sender_private_key_sha256",
    "recovery_approval_key_id", "recovery_approval_key_fingerprint",
    "recovery_approval_public_key_hex", "recovery_approval_private_key_path",
    "recovery_approval_private_key_sha256",
    "revocation_execution_reservation_key_id",
    "revocation_execution_reservation_public_key_hex",
    "minimum_reservation_config_generation",
    "endpoint_state_directory", "endpoint_anchor_directory", "owner_mappings",
    "device_proof_keys", "issued_at_epoch_s", "expires_at_epoch_s",
    "configuration_key_id", "signature"
  ],
  "properties": {
    "schema": { "const": "crowsi://device-credential-agent/config/v6" },
    "deployment_role": { "const": "managed-device-endpoint" },
    "endpoint_deployment_id": { "$ref": "#/$defs/id" },
    "configuration_generation": { "$ref": "#/$defs/positiveU64" },
    "authority_route": { "$ref": "#/$defs/remoteAuthorityRoute" },
    "identity_authority_route": { "$ref": "#/$defs/remoteAuthorityRoute" },
    "pa_authorization_route": { "$ref": "#/$defs/paAuthorizationRoute" },
    "management_projection_trust": { "$ref": "#/$defs/managementProjectionTrust" },
    "authority_response_key_id": { "$ref": "#/$defs/id" },
    "authority_response_public_key_hex": { "$ref": "#/$defs/key" },
    "minimum_identity_config_generation": { "$ref": "#/$defs/positiveU64" },
    "identity_finalization_authority_id": { "$ref": "#/$defs/id" },
    "revocation_approval_authority_ref": { "$ref": "#/$defs/id" },
    "identity_issuer": { "type": "string", "minLength": 1, "maxLength": 512 },
    "identity_audience": { "$ref": "#/$defs/id" },
    "identity_key_id": { "$ref": "#/$defs/id" },
    "identity_public_key_hex": { "$ref": "#/$defs/key" },
    "current_status_key_id": { "$ref": "#/$defs/id" },
    "current_status_public_key_hex": { "$ref": "#/$defs/key" },
    "user_verification_key_id": { "$ref": "#/$defs/id" },
    "user_verification_public_key_hex": { "$ref": "#/$defs/key" },
    "user_verification_credential_id": { "$ref": "#/$defs/credentialId" },
    "user_verification_account_binding_sha256": { "$ref": "#/$defs/key" },
    "session_sender_key_id": { "$ref": "#/$defs/id" },
    "session_sender_key_fingerprint": { "$ref": "#/$defs/key" },
    "session_sender_public_key_hex": { "$ref": "#/$defs/key" },
    "session_sender_private_key_path": { "$ref": "#/$defs/absolutePath" },
    "session_sender_private_key_sha256": { "$ref": "#/$defs/digest" },
    "recovery_approval_key_id": { "$ref": "#/$defs/id" },
    "recovery_approval_key_fingerprint": { "$ref": "#/$defs/key" },
    "recovery_approval_public_key_hex": { "$ref": "#/$defs/key" },
    "recovery_approval_private_key_path": { "$ref": "#/$defs/absolutePath" },
    "recovery_approval_private_key_sha256": { "$ref": "#/$defs/digest" },
    "revocation_execution_reservation_key_id": { "$ref": "#/$defs/id" },
    "revocation_execution_reservation_public_key_hex": { "$ref": "#/$defs/key" },
    "minimum_reservation_config_generation": { "$ref": "#/$defs/positiveU64" },
    "endpoint_state_directory": { "$ref": "#/$defs/absolutePath" },
    "endpoint_anchor_directory": { "$ref": "#/$defs/absolutePath" },
    "owner_mappings": { "type": "array", "minItems": 1, "maxItems": 10000,
      "items": { "$ref": "#/$defs/ownerMapping" } },
    "device_proof_keys": { "type": "array", "minItems": 1, "maxItems": 1,
      "items": { "$ref": "#/$defs/deviceProofKeyTrust" } },
    "issued_at_epoch_s": { "$ref": "#/$defs/u64" },
    "expires_at_epoch_s": { "$ref": "#/$defs/u64" },
    "configuration_key_id": { "$ref": "#/$defs/id" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "$defs": {
    "u64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "positiveU64": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^(?:[^\\s\\u0000-\\u001f\\u007f]|[^\\s\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])$" },
    "routeId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reference": { "type": "string", "minLength": 1, "maxLength": 240 },
    "credentialId": { "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$" },
    "key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "opaqueOwner": { "type": "string", "pattern": "^psa_[A-Za-z0-9_-]{20,124}$" },
    "pairwiseSubject": { "type": "string", "pattern": "^psu_[A-Za-z0-9_-]+$", "maxLength": 128 },
    "ownerMapping": { "type": "object", "additionalProperties": false,
      "required": ["issuer", "service_id", "pairwise_subject", "opaque_owner_ref"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1, "maxLength": 512 },
        "service_id": { "$ref": "#/$defs/id" },
        "pairwise_subject": { "$ref": "#/$defs/pairwiseSubject" },
        "opaque_owner_ref": { "$ref": "#/$defs/opaqueOwner" }
      }
    },
    "deviceProofKeyTrust": { "type": "object", "additionalProperties": false,
      "required": ["opaque_owner_ref", "device_id", "device_proof_key_ref", "public_key_hex",
        "custody", "custody_executable", "custody_executable_sha256", "custody_credential_id",
        "custody_expected_revision"],
      "properties": {
        "opaque_owner_ref": { "$ref": "#/$defs/opaqueOwner" }, "device_id": { "$ref": "#/$defs/id" },
        "device_proof_key_ref": { "$ref": "#/$defs/reference" }, "public_key_hex": { "$ref": "#/$defs/key" },
        "custody": { "enum": ["hardware-nonexportable", "software-nonexportable"] },
        "custody_executable": { "$ref": "#/$defs/absolutePath" },
        "custody_executable_sha256": { "$ref": "#/$defs/digest" },
        "custody_credential_id": { "$ref": "#/$defs/id" },
        "custody_expected_revision": { "type": "string", "pattern": "^rev1:[0-9a-f]{64}$" }
      }
    },
    "managementProjectionTrust": { "type": "object", "additionalProperties": false,
      "required": ["issuer", "audience", "service_id", "pairwise_subject", "opaque_account_ref",
        "current_device_ref", "minimum_subject_revocation_epoch", "minimum_service_revocation_epoch",
        "minimum_device_revocation_epoch", "minimum_session_revocation_epoch", "device_posture_state",
        "minimum_device_posture_revision", "device_proof_key_ref", "minimum_snapshot_revision",
        "key_id", "public_key_hex"],
      "properties": {
        "issuer": { "$ref": "#/$defs/routeId" }, "audience": { "$ref": "#/$defs/routeId" },
        "service_id": { "$ref": "#/$defs/id" }, "pairwise_subject": { "$ref": "#/$defs/pairwiseSubject" },
        "opaque_account_ref": { "$ref": "#/$defs/opaqueOwner" }, "current_device_ref": { "$ref": "#/$defs/id" },
        "minimum_subject_revocation_epoch": { "$ref": "#/$defs/positiveU64" },
        "minimum_service_revocation_epoch": { "$ref": "#/$defs/positiveU64" },
        "minimum_device_revocation_epoch": { "$ref": "#/$defs/positiveU64" },
        "minimum_session_revocation_epoch": { "$ref": "#/$defs/positiveU64" },
        "device_posture_state": { "const": "compliant" },
        "minimum_device_posture_revision": { "$ref": "#/$defs/positiveU64" },
        "device_proof_key_ref": { "$ref": "#/$defs/reference" },
        "minimum_snapshot_revision": { "$ref": "#/$defs/positiveU64" },
        "key_id": { "$ref": "#/$defs/id" }, "public_key_hex": { "$ref": "#/$defs/key" }
      }
    },
    "remoteAuthorityRoute": { "type": "object", "additionalProperties": false,
      "required": ["schema", "binding_sha256", "address", "server_name", "audience", "device_id",
        "endpoint_deployment_id", "authority_deployment_id", "client_certificate_path",
        "client_certificate_sha256", "client_private_key_path", "client_private_key_sha256",
        "server_trust_anchor_path", "server_trust_anchor_sha256", "server_certificate_sha256",
        "request_key_id", "request_public_key_hex", "request_signing_key_path",
        "request_signing_key_sha256", "response_key_id", "response_public_key_hex", "timeout_ms"],
      "properties": {
        "schema": { "const": "crowsi://authority-transport/endpoint-route/v1" },
        "binding_sha256": { "$ref": "#/$defs/digest" }, "address": { "type": "string", "minLength": 1, "pattern": ":", "maxLength": 256 },
        "server_name": { "type": "string", "minLength": 1, "maxLength": 253 }, "audience": { "$ref": "#/$defs/routeId" },
        "device_id": { "$ref": "#/$defs/id" }, "endpoint_deployment_id": { "$ref": "#/$defs/id" },
        "authority_deployment_id": { "$ref": "#/$defs/id" }, "client_certificate_path": { "$ref": "#/$defs/absolutePath" },
        "client_certificate_sha256": { "$ref": "#/$defs/digest" }, "client_private_key_path": { "$ref": "#/$defs/absolutePath" },
        "client_private_key_sha256": { "$ref": "#/$defs/digest" }, "server_trust_anchor_path": { "$ref": "#/$defs/absolutePath" },
        "server_trust_anchor_sha256": { "$ref": "#/$defs/digest" }, "server_certificate_sha256": { "$ref": "#/$defs/digest" },
        "request_key_id": { "$ref": "#/$defs/id" }, "request_public_key_hex": { "$ref": "#/$defs/key" },
        "request_signing_key_path": { "$ref": "#/$defs/absolutePath" }, "request_signing_key_sha256": { "$ref": "#/$defs/digest" },
        "response_key_id": { "$ref": "#/$defs/id" }, "response_public_key_hex": { "$ref": "#/$defs/key" },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000 }
      }
    },
    "paAuthorizationRoute": { "type": "object", "additionalProperties": false,
      "required": ["schema", "executable", "executable_sha256", "config_path", "config_sha256",
        "response_key_id", "response_public_key_hex", "timeout_ms"],
      "properties": {
        "schema": { "const": "crowsi://device-credential-agent/pa-authorization-route/v1" },
        "executable": { "$ref": "#/$defs/absolutePath" }, "executable_sha256": { "$ref": "#/$defs/digest" },
        "config_path": { "$ref": "#/$defs/absolutePath" }, "config_sha256": { "$ref": "#/$defs/digest" },
        "response_key_id": { "$ref": "#/$defs/id" }, "response_public_key_hex": { "$ref": "#/$defs/key" },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000 }
      }
    }
  }
}
