{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://device-credential-agent/root-trust/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "configuration_key_id", "configuration_public_key_hex"],
  "properties": {
    "schema": { "const": "crowsi://device-credential-agent/root-trust/v1" },
    "configuration_key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "configuration_public_key_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
