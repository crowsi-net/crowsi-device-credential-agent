{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://credential-authority/adapter-response/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command", "request_digest_sha256", "authority_epoch", "issued_at_epoch_s", "expires_at_epoch_s", "payload", "key_id", "signature"],
  "properties": {
    "schema": { "const": "crowsi://credential-authority/adapter-response/v1" },
    "command": { "enum": ["snapshot", "prepare", "finish", "cancel", "reconcile"] },
    "request_digest_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "authority_epoch": { "type": "integer", "minimum": 1 },
    "issued_at_epoch_s": { "type": "integer", "minimum": 1 },
    "expires_at_epoch_s": { "type": "integer", "minimum": 1 },
    "payload": { "type": "object" },
    "key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  }
}
